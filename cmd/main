#!/bin/bash
# Fntv-Plus 影视增强后端生命周期脚本（严格按照飞牛官方退出码：0=运行中 1=失败 3=未运行）。
# 由 fnOS appcenter 在 start/stop/status 时调用。

BIN="$TRIM_APPDEST/server/fntvplus"
PIDFILE="$TRIM_PKGVAR/fntvplus.pid"
LOG="$TRIM_PKGVAR/fntvplus.log"

start() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && exit 0
  mkdir -p "$TRIM_PKGVAR"
  nohup "$BIN" \
    --port "$TRIM_SERVICE_PORT" \
    --etc "$TRIM_PKGETC" \
    --var "$TRIM_PKGVAR" \
    --dest "$TRIM_APPDEST" \
    >> "$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  exit 0
}

stop() {
  if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
  fi
  exit 0
}

status() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && exit 0
  exit 3
}

case "$1" in
  start)  start  ;;
  stop)   stop   ;;
  status) status ;;
  *) echo "usage: $0 {start|stop|status}" >&2; exit 1 ;;
esac
